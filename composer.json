{
    "name": "itlink/car-ads",
    "description": "REST API сервис объявлений автомобилей на Yii2 и PostgreSQL",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "yiisoft/yii2": "~2.0.49"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
